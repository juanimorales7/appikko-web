# URL pública del sitio (sin barra final). Se usa en metadata, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=https://appiko.tech

# --- Formulario de contacto: elegí UNA opción ---

# Opción A · Resend (recomendado). El formulario envía a /api/contacto y el servidor manda el mail.
RESEND_API_KEY=
# Remitente verificado en Resend (ej. "Appiko Web <web@appiko.tech>"). Sin dominio verificado: "onboarding@resend.dev".
CONTACT_FROM=
# Casilla donde querés recibir los mensajes.
CONTACT_TO=

# Opción B · Formspree. El navegador envía directo a Formspree (no hace falta servidor).
NEXT_PUBLIC_FORMSPREE_ID=
